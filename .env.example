# Formspree form ID — used only by the server-side consultation endpoint.
NEXT_PUBLIC_FORMSPREE_ID=your_form_id_here

# Server-only Abel Log intake. Never prefix the token with NEXT_PUBLIC_.
ABEL_LOG_INTAKE_URL=https://log.abeliquidators.com/hooks/intake
ABEL_LOG_INTAKE_TOKEN=

# Mailchimp embedded form URL (from Mailchimp → Audience → Signup forms → Embedded forms)
# Format: https://YOURDOMAIN.usX.list-manage.com/subscribe/post?u=USERID&id=AUDIENCEID
NEXT_PUBLIC_MAILCHIMP_URL=
